# ETAPA 1: Construcción
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copiamos el SLN correcto
COPY *.sln .

# IMPORTANTE: Asumo que dentro de la carpeta "Taller_REST_API" (Captura 1)
# hay OTRA carpeta llamada "Taller_REST_API" con el .csproj.
# Si el csproj tiene otro nombre, ajusta la línea de abajo.
COPY Taller_REST_API/*.csproj ./Taller_REST_API/
# Si tienes tests, descomenta y ajusta:
# COPY Taller_REST_API.Tests/*.csproj ./Taller_REST_API.Tests/

RUN dotnet restore

COPY . .
WORKDIR "/src/Taller_REST_API"
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# ETAPA 2: Ejecución
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
EXPOSE 8080
EXPOSE 80

COPY --from=build /app/publish .
# El nombre de la DLL suele ser el nombre del proyecto
ENTRYPOINT ["dotnet", "Taller_REST_API.dll"]